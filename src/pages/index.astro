---
import Layout from "../layouts/Layout.astro";
import HeaderBar from "../components/HeaderBar.astro";
import { GITHUB_ICON } from "../constants";
---

<Layout>
  <div
    class="min-w-screen min-h-screen py-10"
    style="background-image: linear-gradient(#d1d5db 1px, transparent 1px), linear-gradient(90deg, #d1d5db 1px, transparent 1px); background-size: 20px 20px;"
  >
    <div class="w-5/6 md:3/6 lg:w-2/4 xl:w-1/4 2xl:1/4 mx-auto">
      <HeaderBar />

      <div class="fixed flex flex-col top-14 right-6 space-y-2">
        <button
          id="language-toggle"
          class="border-black flex items-center justify-center border-2 rounded-full hover:bg-gray-200 active:bg-gray-300 w-8 h-8"
        >
          <img
            id="language-flag"
            src="https://hatscripts.github.io/circle-flags/flags/gb.svg"
            alt="UK flag"
            class="w-6 h-6"
          />
        </button>
        <a
          href="https://github.com/Xaypanya/Avocab"
          target="_blank"
          rel="noopener noreferrer"
          class="border-black flex items-center justify-center border-2 rounded-full hover:bg-gray-200 active:bg-gray-300 w-8 h-8"
        >
          <img src={GITHUB_ICON} class="w-6 h-6" alt="GitHub Icon" />
        </a>
      </div>

      <div class="fixed flex flex-col bottom-14 right-6">
        <button
          id="go-to-top"
          class="border-black hover:shadow-lg bg-avocab-400 hover:bg-avocab-500 active:bg-avocab-600 flex items-center justify-center border-2 rounded-full w-8 h-14"
        >
          <svg class="text-black h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
        </button>
      </div>

      <div class="space-y-4 mt-4">
        <div id="empty-state" class="flex flex-col space-y-4 justify-center items-center hidden">
          <div id="empty-lottie" class="h-64 w-64"></div>
          <p id="empty-state-text" class="text-gray-500 -translate-y-12"></p>
        </div>
        <div id="word-list" class="space-y-4"></div>
      </div>
    </div>
  </div>

  <script src="../scripts/app.js"></script>
</Layout>
