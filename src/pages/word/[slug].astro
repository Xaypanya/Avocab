---
import Layout from "../../layouts/Layout.astro";
import WordCard from "../../components/WordCard.astro";
import words from "../../data/words.json";

export function getStaticPaths() {
  return words.map((word) => ({
    params: { slug: word.slug },
    props: { word },
  }));
}

const { word } = Astro.props;
const capitalize = (str) => (str ? str[0].toUpperCase() + str.slice(1) : str);
const title = `${capitalize(word.english)} in Lao — ${word.lao} | Avocab`;
const description = `How to say "${word.english}" in Lao: ${word.lao} (${word.type}). Listen to the pronunciation and learn more English-Lao vocabulary with Avocab.`;
---

<Layout
  title={title}
  description={description}
  keywords={`${word.english}, ${word.lao}, English to Lao, ${word.english} in Lao, Lao dictionary, Lao translation`}
  canonicalPath={`/word/${word.slug}/`}
>
  <div
    class="min-w-screen min-h-screen py-10"
    style="background-image: linear-gradient(#d1d5db 1px, transparent 1px), linear-gradient(90deg, #d1d5db 1px, transparent 1px); background-size: 20px 20px;"
  >
    <div class="w-5/6 md:3/6 lg:w-2/4 xl:w-1/4 2xl:1/4 mx-auto space-y-4">
      <a
        href={import.meta.env.BASE_URL}
        class="inline-flex items-center gap-1 text-sm text-gray-600 hover:text-black hover:underline"
      >
        &larr; Back to Avocab
      </a>
      <h1 class="sr-only">How to say "{word.english}" in Lao</h1>
      <WordCard word={word} />
      <p class="text-gray-600 text-sm">
        Learn how to pronounce and translate <strong>{word.english}</strong> ({word.type})
        between English and Lao (<span lang="lo">{word.lao}</span>) with Avocab, a free
        English-Lao dictionary.
      </p>
    </div>
  </div>

  <script src="../../scripts/wordPage.js"></script>
</Layout>
